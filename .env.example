# Copy to .env and fill in. The API, worker, and CLI read these at startup.

# --- Vertex AI / GCP (required) ---
# Your Google Cloud project ID. If unset, it is resolved from Application
# Default Credentials (gcloud auth application-default login).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Where Gemini requests are served. gemini-3-pro is only on the "global"
# endpoint (not regional endpoints like us-central1). This is separate from the
# Cloud Run deployment region.
GOOGLE_CLOUD_LOCATION=global

# Use Vertex AI (True) rather than the AI Studio API key path (False).
GOOGLE_GENAI_USE_VERTEXAI=True

# --- Optional observability ---
# GCS bucket for artifacts and prompt/response logs.
# LOGS_BUCKET_NAME=your-logs-bucket
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# Structured logging (structlog). Format auto-detects: JSON on Cloud Run (where
# K_SERVICE is set), colorized console locally. Override either:
# LOG_FORMAT=json        # force JSON (or: console)
# LOG_LEVEL=INFO         # DEBUG also unmutes noisy google/httpx/uvicorn loggers

# --- Web API origins / CORS for the gateway (Phase 5) ---
# Comma-separated origins allowed to call the API (the Next.js frontend).
# WEB_ORIGINS takes precedence; ALLOW_ORIGINS is the fallback. Defaults to
# http://localhost:3000.
# WEB_ORIGINS=https://your-frontend.example.com
# ALLOW_ORIGINS=https://your-frontend.example.com

# --- Work dispatch: Cloud Tasks + the worker service (Phase B) ---
# Unset (the default) runs discovery/scoring/sweeps as in-process background
# tasks — fine locally and in tests, but on Cloud Run scale-down can kill them
# mid-run. With QUEUE_MODE on, that work is enqueued to Cloud Tasks and pushed
# to the private hermes-worker service instead.
#
# The API process logs which of the two it will use at boot ("api.boot",
# execution_mode=queued|in_process), and POST /settings/discovery/run returns
# the same value as "mode".
#
# QUEUE_MODE=1                 # "1"/"true"/"on"; enables enqueueing
# WORKER_URL=https://hermes-worker-<num>.<region>.run.app
# TASKS_SA_EMAIL=hermes-tasks@<project>.iam.gserviceaccount.com
# TASKS_LOCATION=us-central1   # queue region; defaults to us-central1
#
# Set on the WORKER deployment only. Makes that process *be* the worker: it
# enables the /tasks/* handlers, which 404 everywhere else. The worker runs the
# same image as the API and is deployed private, so Cloud Run verifies the
# Cloud Tasks / Cloud Scheduler OIDC token before any app code runs.
# WORKER_MODE=1
#
# Shared secret guarding POST /internal/cron/tick, checked via the
# X-Cron-Secret header. Only consulted when WORKER_MODE is off (on the worker
# the OIDC check has already happened). Unset disables the endpoint with a 503.
# CRON_SECRET=

# --- Per-user scoring budget (Phase 1B viability) ---
# How many jobs one user may have scored, at most. Every scorer (online,
# batch, and the resumable batch runs) reserves its slots up front and scores
# only what it is granted; unused slots are refunded when the run ends, and
# both counters roll over lazily (UTC day / per cycle).
#
# Uncapped, one signup's first discovery cycle fetched ~13,000 jobs and cost
# $28-32. The defaults below bound that.
#
# MEASURED 2026-08-23, not estimated: one capped 100-job run cost $0.979287,
# i.e. $0.0098/job ($0.00279 per Flash parse, $0.01649 per cached Pro score).
# So the defaults make the worst case ~$1.96 per cycle and ~$3.92 per day, per
# user — which is what keeps a first cycle under the $2 target.
#
# That rate is ~2.2x the ~$0.004/job measured in July; both models now emit
# billed thinking tokens. RE-MEASURE from users/{uid}/runs before trusting
# these numbers — the price moved once with no code change on our side.
#
# A slot is charged per job ATTEMPTED, not per LLM call: an out-of-family job
# rejected locally still costs a slot (~55% of jobs in the measured run). That
# is deliberate — charging only on a priced call would let an all-rejection
# backlog stream without limit.
#
# SCORING_BUDGET_PER_CYCLE=200    # default 200
# SCORING_BUDGET_PER_DAY=400      # default 400
#
# The cycle counter rolls over when a new cycle opens, NOT on a clock: an
# ad-hoc score task draws down the window discovery opened rather than opening
# its own, so once a window is spent it waits for the next discovery cycle.
# The daily counter rolls at UTC midnight.
#
# There is no env switch to disable the cap — the only bypass is
# `python -m cli.run_matching --ignore-budget`, for operator backlog runs, and
# even that stays capped at 300 jobs per invocation unless --limit is given.

# --- Deterministic geo gate enforcement (Phase 1D viability) ---
# tools/matching/geo.py decides in Python, for free, the part of the scoring
# prompt's Rule 6 that Python can prove: can this candidate hold this job from
# where they live? Today it only *records* its verdict beside Pro's (Phase 1C
# shadow mode). GEO_GATE_ENFORCE lets it act on it — skipping the Pro call
# outright for a job it proves unreachable.
#
# OFF by default, and shipped off. Turning it on is a behavior change, not a
# tuning knob.
#
# MEASURED, not estimated:
#   - 0 false positives over 1,127 historical scored+parsed records (that
#     corpus is survivorship-filtered, so it can falsify the gate but cannot
#     show its coverage).
#   - fires `ineligible` on 29.3% of 7,266 cross-user jd_cache parses — the
#     unfiltered corpus, which is where the coverage number comes from.
#     Reproduce both with `python -m cli.geo_replay`.
# At the measured $0.0098/job, skipping ~29% of a 200-job cycle is ~$0.57.
#
# Enforcement is restricted to US residents at the enforcement site (not inside
# geo.py): the gate reads exactly one profile field, both measured profiles
# normalize to "US", and for a non-US resident the rule structure INVERTS —
# the us_remote_ok safety valve (73.4% of the kept corpus) is hard-gated on US
# and never fires, while country_mismatch fires against nearly every US
# posting. There are zero non-US users today, so this costs nothing.
#
# GEO_GATE_ENFORCE=1              # default off
#
# A skip writes a `discarded_jobs` tombstone, and that collection is discovery's
# dedupe key — checked BEFORE the job doc — so a wrong skip suppresses the
# posting on every future re-discovery, not just once. Enforced tombstones
# therefore carry a full `restore` payload (jd_raw + jd_parsed + identity), and
# `python -m cli.geo_resurrect --user-id <uid>` re-runs the current gate over
# them and puts back everything whose verdict changed. Offline, free, dry-run
# by default. A GATE_VERSION bump is meant to be resolved that way.
#
# GEO_GATE_HOLDOUT is the fraction of gate-rejected jobs scored by Pro ANYWAY,
# recorded through the normal shadow path. It is permanent, not a rollout ramp:
# once enforcing, the enforced population produces no Pro comparison ever
# again, which is a permanent hole in the only metric that justifies the gate.
# Sampling is deterministic on sha256(job.id) — a batch run decides at submit
# and joins the responses hours later in a different process, and a job that
# flipped in between would corrupt that content join.
#
# GEO_GATE_HOLDOUT=0.10           # default 0.10; out-of-range values ignored

# --- Shared board cache (Phase 4 viability) ---
# Every user's discovery cycle walks the same ~198 boards independently. That
# duplication is measured, not assumed: two users' cycles each fetched 13,083
# jobs with byte-identical per-platform splits. tools/ats/board_cache.py stores
# each board's normalized Job list once, in GCS, under
# gs://<RESUME_BUCKET>/board_cache/<platform>/<slug>.json, and every user's
# cycle inside the TTL reads it instead of re-crawling.
#
# 0 (the default) disables it completely: no GCS client is built, nothing is
# read or written, and the fan-out is byte-for-byte the pre-cache code path.
# Shipped off on purpose — turn it on only after a deploy shows the blobs.
#
# The floor on discovery_interval_hours is 6, so any TTL up to 6h is invisible
# to a user's own cadence. The one visible change: POST /settings/discovery/run
# clicked twice inside the TTL serves the second click from the cache.
#
# Effect is reported per cycle as `boards_cached` / `boards_fetched` on
# discovery_state.last_discovery and in the auto_discovery.metrics log line.
#
# An EMPTY board is never cached — a failed fetch and an empty board are
# indistinguishable at that seam, and caching a failure would hide a board from
# every user for a whole TTL.
#
# BOARD_CACHE_TTL_SECONDS=3600    # default 0 (off)

# --- Tailored resume storage (Phase 6/7) ---
# GCS bucket for tailored resumes + submission screenshots. Defaults to
# "<GOOGLE_CLOUD_PROJECT>-resumes" if unset.
# RESUME_BUCKET=your-project-resumes

# --- Company sweep (Phase 3.6) ---
# Serper.dev search API key. NOTE: a PAID plan is required — the free tier
# rejects site: / advanced-operator queries ("Query pattern not allowed").
# SERPER_API_KEY=
# Sweep backend: "serper" (paid, reliable) or "direct" (free Google scraping, fragile).
# DISCOVERY_BACKEND=serper

# --- Web API (Phase 5) ---
# Local-only auth bypass for the web endpoints. NEVER enable in production.
# AUTH_DEV_MODE=1
# AUTH_DEV_USER=me
# Allowed CORS origins for the Next.js frontend (comma-separated).
# WEB_ORIGINS=http://localhost:3000

# --- Web frontend dev tools (Phase: onboarding) ---
# Shows dev-only affordances in the web app — currently the onboarding
# "Use a sample resume" button, which runs a real extraction and overwrites the
# signed-in user's profile. On automatically under `next dev`; set to 1 at BUILD
# time to also expose them on a deployed dev instance. Leave unset in production.
# NEXT_PUBLIC_DEV_TOOLS=1

# --- Invite gate for email/password sign-up (web) ---
# Access is gated server-side by the allowlist (ALLOWLIST_ENFORCED, seats
# managed with `python -m cli.allowlist`). The old NEXT_PUBLIC_INVITE_CODES
# client-side gate was removed once that landed: its codes shipped in the
# browser bundle, and it only ever covered email/password signup, never Google.
